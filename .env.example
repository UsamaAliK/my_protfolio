# Google Gemini API key for the portfolio chat assistant.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Smallest/cheapest model tier that is still strong enough for resume Q&A.
# Options: gemini-3.1-flash-lite (pinned, cheapest stable),
#          gemini-3.5-flash-lite, gemini-flash-lite-latest (floating alias)
GEMINI_MODEL=gemini-3.1-flash-lite
